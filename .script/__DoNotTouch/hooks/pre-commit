#!/usr/bin/env bash
# .script/__DoNotTouch/hooks/pre-commit

set -eu
hook_dir="$(dirname "$0")"
source "$hook_dir/common.sh"

# --- 親/子ルート判定 ---
ROOT="$(resolve_root)"

cd "$ROOT"

is_submodule=0
if [ -n "$(git rev-parse --show-superproject-working-tree 2>/dev/null)" ]; then
    is_submodule=1
fi

# --- Staged変更の確認 (早期リターン) ---
if git diff --cached --quiet --exit-code; then
    [ "$is_submodule" -eq 1 ] && log_info "No staged changes in submodule. Exiting." && exit 0
fi

# 1. 画像処理 (親・子 共通)
if [ -f "$hook_dir/handle-images.sh" ]; then
    log_info "Running handle-images.sh"
    bash "$hook_dir/handle-images.sh" || exit 1
fi

# 2. サブモジュールの自動コミット (親 専用)
if [ "$is_submodule" -eq 0 ] && [ -f "$hook_dir/commit-submodules.sh" ]; then
    log_info "Running commit-submodules.sh"
    bash "$hook_dir/commit-submodules.sh" "git" || exit 1
fi

# 3. アップストリームとの同期 (親 専用)
if [ "$is_submodule" -eq 0 ] && [ -f "$hook_dir/sync-original.sh" ]; then
    log_info "Running sync-original.sh"
    bash "$hook_dir/sync-original.sh" "git" || log_warn "sync-original.sh returned non-zero; continuing."
fi

exit 0