==============================================================================

Knewrova[ult] Environment Settings (.env)

==============================================================================

# --- 共通・基本設定 ---
# true の場合、ファイルの書き込みやリモートへの Push を行わずにログ出力のみ行います
DRY_RUN=false

# ユーザーID (共有フォルダ上のパス解決等に使用。未指定時はOSのユーザー名から自動取得)
USER_ID={{USER_ID}}

# Git 実行ファイルのパス (PortableGit 等を使用する場合に明示)
# 未指定時は %USERPROFILE%\Software\PortableGit\cmd\git.exe や PATH から自動探索します
GIT_EXE=%USERPROFILE%\Software\PortableGit\cmd\git.exe

# --- リポジトリ・共有フォルダのパス設定 ---
# Rドライブとしてマウントする UNC パス (Clone-and-Initialize 等で使用)
R_SHARE_UNC="\server\share\repository"

# 組織/チームのメインリポジトリ (R: ドライブ基準)
TEAM_REPO=R:\CTH-Nexus.git

# ユーザーの個人リポジトリのパス (未指定時は R:\UsersVault{USER_ID}.git が自動生成されます)
REPO_PATH=R:\UsersVault{USER_ID}.git

# 共有フォルダ上のベアリポジトリパス (Git-ConfigCheck用。未指定時は origin から自動取得)
REMOTE_GIT_DIR=R:\UsersVault{USER_ID}.git

# --- ソフトウェアと Obsidian の同期設定 ---
# ソフトウェアインストーラが置かれているディレクトリ (SoftwareCheck.ps1 用)
SHARED_FOLDER="\server\share\Software"

# Obsidian プラグイン配布元ディレクトリ (Sync-ObsidianPluginsFromShare.ps1 用)
PLUGINS_SOURCE_DIR="\server\share\obsidian\plugins"

# (任意) プラグイン同期で許可・除外する設定

PLUGINS_EXT_ALLOW=.js,.css,.json,.png
PLUGINS_EXCLUDE_NAMES=data.json,data.default.json
PLUGINS_PROMPT_MODE=PerPlugin  # PerPlugin | PerFile | None
PLUGINS_BACKUP=1

# --- 画像処理フック設定 (upload-images.sh / rewrite-mdlink.sh) ---
# 画像のアップロード先ルート (Rドライブ前提)
UPLOAD_ROOT=R:\Upload

# 画像として認識する拡張子 (カンマ区切り、svg は含めない)
IMAGE_EXTS=.png,.jpg,.jpeg,.gif,.bmp,.tif,.tiff,.webp

# Markdown 内の WikiLink を標準リンクに書き換えるか
REWRITE_MD=true

# 処理ログの出力先
LOG_PATH=uploads.log

# --- コミット・同期フック設定 (commit-submodules.sh) ---
# コミットメッセージの接頭辞
COMMIT_MESSAGE_PREFIX="Setup Submodules"

# 日付フォーマット (Bash の date 書式)
DATE_FORMAT=%Y-%m-%d %H:%M:%S

# タイムゾーン (未設定ならシステム設定を使用)
TIMEZONE=Asia/Tokyo

# サブモジュールの並列処理ジョブ数 (大量のサブモジュールがある場合に有効。Windowsでは 8〜16 程度を推奨)
GIT_SUBMODULE_JOBS=8

# --- プッシュ・衝突防止設定 (collision-check-and-lock.sh) ---
# ロックの有効期限 (秒)
LOCK_TTL_SECONDS=300

# ロック取得失敗時の最大リトライ回数
LOCK_RETRY_MAX=15

# 共有フォルダ上のロックファイル保存ディレクトリ名
LOCK_BASE_SUBDIR=locks

# リポジトリ全体のグローバルロックを有効にするか
ENABLE_GLOBAL_LOCK=true

# ブランチごとの個別ロックを有効にするか
ENABLE_PER_REF_LOCK=true
